{
  "name": "Watch Design Studio",
  "short_name": "Watch Studio",
  "description": "Parametric watch dial and case design studio. Runs entirely on the device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#F5F5F7",
